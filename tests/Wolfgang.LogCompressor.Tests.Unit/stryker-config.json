{
  "stryker-config": {
    "project": "Wolfgang.LogCompressor.csproj",
    "target-framework": "net10.0",
    "mutate": [
      "!**/Service/ProcessLock.cs"
    ],
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 95,
      "low": 92,
      "break": 92
    },
    "ignore-methods": [
      "LogTrace",
      "LogDebug",
      "LogInformation",
      "LogWarning",
      "LogError",
      "LogCritical",
      "WriteLine",
      "WriteLineAsync",
      "ConfigureAwait"
    ]
  }
}
