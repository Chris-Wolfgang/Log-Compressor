<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <!-- This is a self-contained CLI executable, not a library/tool. It is
         distributed as per-RID binaries attached to the GitHub Release, not
         pushed to NuGet. IsPackable=false makes the release.yaml NuGet path
         (pack/smoke-test/publish) no-op gracefully via its has-packages gate. -->
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Copyright>Copyright 2026 Chris Wolfgang</Copyright>
    <Description>Cross-platform CLI tool to compress log files</Description>
    <Authors>Chris Wolfgang</Authors>
    <RepositoryUrl>https://github.com/Chris-Wolfgang/Log-Compressor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyName>logc</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bind IConfiguration via the source generator (reflection-free) so single-file
         and trimmed publishes are clean. This replaces the suppressed SYSLIB1104. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Unit" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Integration" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Fuzz" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <!-- CRC-32 for gzip trailer validation in ArchiveVerifier: GZipStream no
         longer fails on truncated input, so the verifier checks the stream's
         own trailer itself. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AppSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
