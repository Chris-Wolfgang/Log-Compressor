{
  "stryker-config": {
    "project": "src/Wolfgang.LogCompressor/Wolfgang.LogCompressor.csproj",
    "test-projects": [
      "tests/Wolfgang.LogCompressor.Tests.Unit/Wolfgang.LogCompressor.Tests.Unit.csproj"
    ],
    "target-framework": "net10.0",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 95,
      "low": 88,
      "break": 88
    },
    "ignore-methods": [
      "LogTrace",
      "LogDebug",
      "LogInformation",
      "LogWarning",
      "LogError",
      "LogCritical",
      "WriteLine",
      "WriteLineAsync",
      "ConfigureAwait"
    ]
  }
}
