<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.3</Version>
    <!-- This is a self-contained CLI executable, not a library/tool. It is
         distributed as per-RID binaries attached to the GitHub Release, not
         pushed to NuGet. IsPackable=false makes the release.yaml NuGet path
         (pack/smoke-test/publish) no-op gracefully via its has-packages gate. -->
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Copyright>Copyright 2026 Chris Wolfgang</Copyright>
    <Description>Cross-platform CLI tool to compress log files</Description>
    <Authors>Chris Wolfgang</Authors>
    <RepositoryUrl>https://github.com/Chris-Wolfgang/Log-Compressor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyName>logc</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bind IConfiguration via the source generator (reflection-free) so single-file
         and trimmed publishes are clean. This replaces the suppressed SYSLIB1104. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- logc ships as a Native AOT executable per RID (win-x64, linux-x64, osx-arm64): the native
       binaries are the product. Standard: claude-sessions/standards/aot-smoke.md. Every
       `dotnet publish -r <rid>` of this project is a Native AOT publish, which must run on the
       target OS (no cross-OS compilation).

       InvariantGlobalization is deliberately NOT set: ADR-0004 parses `min-datetime` and
       `max-datetime` with the operator's CultureInfo.CurrentCulture, which needs ICU / NLS data.

       TrimMode=partial (as in ADR-0006) trims the .NET runtime and the libraries that opt in to
       trimming and keeps the rest whole. logc and McMaster.Extensions.CommandLineUtils are also
       rooted explicitly: McMaster finds commands, options, OnExecute and the version member by
       name through reflection, and Native AOT only keeps reflection metadata for what is rooted.
       Without the roots every command fails at startup ("Could not find a property or method
       named GetVersion"). -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TrimMode>partial</TrimMode>
    <!-- IL2104 / IL3053 are the one-line "assembly produced trim / AOT warnings" summaries, and
         only McMaster.Extensions.* report in that summary form (see _McMasterSingleWarn below);
         every other assembly, logc included, reports each IL warning individually, and those
         still fail the Release build. McMaster 5.1.0's reflection-based binding (32 IL2xxx/IL3050
         warnings) is the accepted upstream source; scripts/smoke-published.ps1 runs the native
         binary through every command to prove it works. Remove when the CLI layer moves to a
         trim-safe parser (ADR-0002) or McMaster's AOT generator handles this app. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="logc" />
    <TrimmerRootAssembly Include="McMaster.Extensions.CommandLineUtils" />
  </ItemGroup>

  <!-- McMaster 5.1.0 ships a source generator that switches on when PublishAot=true. It cannot
       compile this app's command layer (CS7036: it calls OnExecuteAsync without the injected
       services; CS9035: it news up commands without the `required` Path; CS0122: private
       GetVersion; CS1503: OnExecute(CommandLineApplication<Program>)), and the metadata it does
       emit for Compress and Bundle has no options, because it skips the ones inherited from
       SharedOptions. Remove it so McMaster binds by reflection, as it does in the JIT build. -->
  <Target Name="_RemoveMcMasterAotGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'McMaster.Extensions.CommandLineUtils.Generators'" />
    </ItemGroup>
  </Target>

  <!-- Report McMaster's trim / AOT warnings as one summary per assembly (IL2104 / IL3053), so
       the narrow WarningsNotAsErrors above covers McMaster and nothing else. -->
  <Target Name="_McMasterSingleWarn" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="$([System.String]::Copy('%(Filename)').StartsWith('McMaster.Extensions.'))">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Unit" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Integration" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Tests.Fuzz" />
    <InternalsVisibleTo Include="Wolfgang.LogCompressor.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <!-- CRC-32 for gzip trailer validation in ArchiveVerifier: GZipStream no
         longer fails on truncated input, so the verifier checks the stream's
         own trailer itself. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AppSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
